{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (Qt 6.10.2)",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.10.2/gcc_64",
                "CMAKE_BUILD_RPATH": "$env{HOME}/Qt/6.10.2/gcc_64/lib",
                "CMAKE_EXE_LINKER_FLAGS": "-Wl,-rpath-link,$env{HOME}/Qt/6.10.2/gcc_64/lib"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ]
}
